{
  "compilerOptions": {
    "types": ["vitest/globals", "vite/client"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "src/vite-env.d.ts"]
}
